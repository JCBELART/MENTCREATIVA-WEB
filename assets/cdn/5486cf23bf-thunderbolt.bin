\n","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofq559j":{"width":700,"height":335,"uri":"32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg","title":"publicidad.jpg","containerId":"comp-iofq559j","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_582,h_340,al_c,lg_1,q_80,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":170,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":170,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-iofq559j","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expandir imagen","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofq559k2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">PUBLICIDAD</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Somos una agencia de publicidad multi - sectorial. Trabajamos para la industria y el comercio en general. Nos dirigimos principalmente a las empresas peque&ntilde;as y medianas, que son el motor de la econom&iacute;a.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Nuestro deseo es ayudar a nuestros clientes a posicionar sus marcas para vender sus productos, servicios y aumentar la fidelidad de sus clientes.</p>\n","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofq559k":{"width":1300,"height":562,"uri":"32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","title":"WEB.jpg","containerId":"comp-iofq559k","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","