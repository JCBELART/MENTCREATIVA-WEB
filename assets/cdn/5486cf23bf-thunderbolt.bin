class=\"wixui-rich-text__text\">POSICIONAMIENTO SEO</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_39 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">HOSTING Y ALOJAMIENTO</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_39 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">SERVICIO T&Eacute;CNICO</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_39 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">SEGURIDAD INFORM&Aacute;TICA</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_39 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">SOCIAL MANAGER ...</span></span></p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lbw33ks5":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33ks5","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Reproducir","pauseLabel":"Pausar"}},"comp-iofrpi8n":{"width":1900,"height":500,"uri":"32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg","title":"eventos2.jpg","containerId":"comp-iofrpi8n","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797