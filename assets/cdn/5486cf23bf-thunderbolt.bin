=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">VALLAS PUBLICIT&Aacute;RIAS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">ROLL - UP</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">ESTAMPACI&Oacute;N T&Eacute;XTIL</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">BANDEROLAS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">ROTULACI&Oacute;N DE FACHADAS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">PUBLICIDAD EXTERIOR</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">ROTULACI&Oacute;N DE STANDS ...</p>\n</li>\n</ul>\n","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lbw33ks41":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33ks41","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Reproducir","pauseLabel":"Pausar"}},"comp-iofq5595":{"width":800,"height":536,"uri":"32797a_d92f7727aafc4888b5902782bc3a177a~mv1.jpg","title":"STANDS.jpg","containerId":"comp-iofq5595","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_d92f7727aafc4888b5902782bc3a177a~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d92f7727aafc4888b5902782bc3a177a~mv1.jpg"