"comp-kesoirni"},"compsToUpdate":[],"isAnchorsLinksOnPageWithoutTopAndBottom":true,"isBuilderComponentModel":false,"anchorNameToCompIdMap":{"Top%20of%20Page":"SCROLL_TO_TOP","Bottom%20of%20Page":"SCROLL_TO_BOTTOM"},"isResponsive":false},"windowScroll":{"headerContainerComponentId":null},"seo":{"pageId":"z29mr","description":"","indexPage":true,"ogImage":"","ogImageHeight":"","ogImageWidth":"","pageName":"AVÍS LEGAL","title":"","advancedSeoData":"{\"tags\":[]}","currentPageUrl":"","translationsData":{},"tpaPageId":"","managingAppDefId":""},"domSelectors":{"allComponentIds":["z29mr","pageBackground_z29mr","Containerz29mr","comp-lbw33kdp","comp-kesofydh","comp-kesohc6c","comp-kesoirni"]},"components":{"componentsUnderFoldMap":{}},"reporter":{"skipPageView":false},"__componentsConfig__":{},"render":{"compProps":{"z29mr":{"className":"theme-vars"},"pageBackground_z29mr":{"fillLayers":{"containerId":"pageBackground_z29mr","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"image":{"width":3387,"height":1994,"uri":"32797a_cd2b1185806a44e98a4ddbf9c15f70da~mv1.jpg","title":"3.jpg","containerId":"pageBackground_z29mr","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"containerWidth":1920,"containerHeight":1920},"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"Containerz29mr":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}},"comp-lbw33kdp":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33kdp","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Reprodueix","pauseLabel":"Pausa"}},"comp-kesofydh":{"wedges":[],"rotatedComponents":[],"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"translations":{"ariaLabel":"canvis de contingut en passar el cursor per sobre"}},"comp-kesohc6c":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:44px; line-height:0.7em; text-align:center;\"> <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:44px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"color:#292929;\" class=\"wixui-rich-text__text\">POLÍTICA DE PRIVACITAT</span></span></span></span> </h2><h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:44px; line-height:0.7em; text-align:center;\"> <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:44px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"color:#292929;\" class=\"wixui-rich-text__text\">-------------------------------------------------- ----------------</span></span></span></span> </h2>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kesoirni":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">1. INFORMACI&Oacute; CORPORATIVA</span></span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\">&nbsp;</h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">En compliment de la Llei 34/2002, de 11 de juliol, de serveis de la societat de la informaci&oacute; i de comer&ccedil; electr&ograve;nic, LOVERS WINE ELEGANCE SL, informa que &eacute;s titular dels llocs web: <a data-auto-recognition=\"true\" href=\"http://www.mentcreativa.es\" target=\"_blank\" class=\"wixui-rich-text__text\">www.mentcreativa.es</a>, d&#39;acord amb l&#39;exig&egrave;ncia de l&#39;article 10 de l&#39;esmentada Llei, LOVERS WINE ELEGANCE SL, notifica les seg&uuml;ents dades: el titular d&#39;aquesta p&agrave;gina web &eacute;s LOVERS WINE ELEGANCE SL amb CIF B67052399. domicili social: CL BALMES 13 3.1., Codi Postal: 08691. Localitat: MONISTROL DE MONTSERRAT. Prov&iacute;ncia: BARCELONA. L&#39;adre&ccedil;a de correu electr&ograve;nic de contacte amb l&#39;empresa &eacute;s: <a data-auto-recognition=\"true\" href=\"mailto:info@mentcreativa.es\" class=\"wixui-rich-text__text\">info@mentcreativa.es</a></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">2. USUARI I R&Egrave;GIM DE RESPONSABILITATS</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">La navegaci&oacute; per acc&eacute;s o &uacute;s de la p&agrave;gina web <a data-auto-recognition=\"true\" href=\"http://www.mentcreativa.es\" target=\"_blank\" class=\"wixui-rich-text__text\">http://www.mentcreativa.es</a> i tots els subdominis i directoris inclosos sota la mateixa, aix&iacute; com els serveis o continguts que a trav&eacute;s d&#39;ell es puguin obtenir i tots els portals de domini propi sota titularitat de LOVERS WINE ELEGANCE SL, atorga la condici&oacute; d&#39;usuari, per la que s&#39;accepten, a l&#39;navegar per la p&agrave;gina LOVERS WINE ELEGANCE SL, totes les condicions d&#39;&uacute;s que s&#39;estableixen aqu&iacute; sense perjudicar l&#39;aplicaci&oacute; de la corresponent normativa d&#39;obligat compliment legal segons el cas. Per aix&ograve;, si les consideracions detallades en aquest Av&iacute;s Legal no s&oacute;n de la seva conformitat, preguem no faci &uacute;s de l&#39;portal, ja que qualsevol &uacute;s que faci de la mateixa o els serveis i continguts en ell inclosos implicar&agrave; l&#39;acceptaci&oacute; dels termes legals recollits en aquest text. La p&agrave;gina web de LOVERS WINE ELEGANCE SL proporciona gran diversitat d&#39;informaci&oacute;, serveis i dades. L&#39;usuari assumeix la seva responsabilitat en l&#39;&uacute;s correcte dels llocs web. Aquesta responsabilitat s&#39;estendr&agrave; a: La veracitat i licitud de les informacions aportades per l&#39;usuari en els formularis emesos per LOVERS WINE ELEGANCE SL per accedir a determinats continguts o serveis oferts per la web. L&#39;&uacute;s de la informaci&oacute;, serveis i dades ofertes per LOVERS WINE ELEGANCE SL contra les disposicions d&#39;aquestes condicions, la Llei, la moral, els bons costums o l&#39;ordre p&uacute;blic o que, en un altre cas, puguin suposar lesi&oacute; dels drets de tercers o de l&#39;funcionament dels llocs web. A aquest efecte, l&#39;Usuari s&#39;abstindr&agrave; d&#39;utilitzar qualsevol dels continguts amb fins o efectes il&middot;l&iacute;cits, prohibits en aquest text, lesius dels drets i interessos de tercers, o que de qualsevol forma puguin danyar, inutilitzar, sobrecarregar, deteriorar o impedir la normal utilitzaci&oacute; dels continguts, altres Usuaris o de qualsevol usuari d&#39;Internet (maquinari i programari). Els usuaris respondran dels danys i perjudicis de tota naturalesa que l&#39;empresa propiet&agrave;ria de la web pugui patir, directament o indirectament, com a conseq&uuml;&egrave;ncia d&#39;incompliment de qualsevol de les obligacions derivades de l&#39;&uacute;s del web i d&#39;aquesta pol&iacute;tica de privacitat. En particular, ia t&iacute;tol merament indicatiu i no exhaustiu, l&#39;Usuari es compromet a no transmetre, difondre o posar a disposici&oacute; de tercers informacions, dades, continguts, missatges, gr&agrave;fics, dibuixos, arxius de so i / o imatge, fotografies del web .</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">3. POL&Iacute;TICA D&#39;ENLLA&Ccedil;OS I EXEMPCIONS DE RESPONSABILITAT</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:center; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">LOVERS WINE ELEGANCE SL, no es fa responsable de l&#39;contingut de les p&agrave;gines web a les que pugui accedir l&#39;usuari a trav&eacute;s dels enlla&ccedil;os establerts als seus llocs web i declara que en cap cas examinar&agrave; ni exercitar&agrave; cap tipus de control sobre el contingut d&#39;altres p&agrave;gines de la xarxa. Aix&iacute; mateix, tampoc garanteix la disponibilitat t&egrave;cnica, exactitud, veracitat, validesa o legalitat de p&agrave;gines alienes a la seva propietat a les que es pugui accedir a trav&eacute;s dels enlaces.LOVERS WINE ELEGANCE SL, declara que ha adoptat totes les mesures necess&agrave;ries per evitar qualsevol dany que pugui derivar-se de la navegaci&oacute; per les seves p&agrave;gines web. En conseq&uuml;&egrave;ncia, LOVERS WINE ELEGANCE SL, no es fa responsable, en cap cas, dels eventuals danys que pugui patir l&#39;usuari a causa de la navegaci&oacute; per Internet. LOVERS WINE ELEGANCE SL, no es responsabilitza dels danys o perjudicis de qualsevol tipus produ&iuml;ts en l&#39;Usuari que portin causa d&#39;errors o desconnexions a les xarxes de telecomunicacions que produeixin la suspensi&oacute;, cancel&middot;laci&oacute;, instal laci&oacute; o interrupci&oacute; de servei de la web durant la prestaci&oacute; d&#39;ell mateix o amb car&agrave;cter previ. L&#39;acc&eacute;s al web: <a data-auto-recognition=\"true\" href=\"http://www.mentcreativa.es\" target=\"_blank\" class=\"wixui-rich-text__text\">http://www.mentcreativa.es</a> no implica l&#39;obligaci&oacute; per part de l&#39;empresa de controlar l&#39;abs&egrave;ncia de virus o qualsevol altre element inform&agrave;tic dany&oacute;s. Correspon a l&#39;Usuari, en tot cas, la disponibilitat d&#39;eines adequades per a la detecci&oacute; i desinfecci&oacute; de programes inform&agrave;tics nocius. LOVERS WINE ELEGANCE SL, no es responsabilitza dels danys produ&iuml;ts en els equips inform&agrave;tics, documents i / o fitxers dels usuaris o de tercers durant la prestaci&oacute; de servei al Portal.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">4. PUBLICITAT</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">El web: <a data-auto-recognition=\"true\" href=\"http://www.mentcreativa.es\" target=\"_blank\" class=\"wixui-rich-text__text\">http://www.mentcreativa.es</a> podr&agrave; albergar continguts publicitaris o patrocinats. Els anunciants o patrocinadors s&oacute;n els &uacute;nics responsables d&#39;assegurar que el material rem&egrave;s per a la seva inclusi&oacute; a la web compleix amb les lleis que en cada cas puguin ser d&#39;aplicaci&oacute;. LOVERS WINE ELEGANCE SL, no ser&agrave; responsable de qualsevol error, inexactitud o irregularitat que puguin contenir els continguts publicitaris o dels patrocinadors.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">5. MODIFICACIONS</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">LOVERS WINE ELEGANCE SL, es reserva el dret a realitzar les modificacions que consideri oportunes, sense av&iacute;s previ, en el contingut dels seus llocs web, tant pel que fa als continguts dels llocs web com per les seves condicions d&#39;&uacute;s o per les condicions generals de contractaci&oacute;. Aquestes modificacions podran realitzar-se, a trav&eacute;s dels seus llocs web, de qualsevol forma admissible en dret i seran d&#39;obligat compliment durant el temps que estiguin publicades a la web i fins que no siguin modificades per altres posteriors.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">6. RESERVA DE COOKIES</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">LOVERS WINE ELEGANCE SL (El Plaer de la Terra) es reserva el dret d&#39;utilitzar cookies en la navegaci&oacute; de l&#39;usuari pels seus llocs web per facilitar la personalitzaci&oacute; i comoditat de la navegaci&oacute;. Seguint la pol&iacute;tica de protecci&oacute; de dades de l&#39;empresa, LOVERS WINE ELEGANCE SL, informa que les cookies s&#39;associen a l&#39;usuari an&ograve;nim i al seu ordinador i no proporcionen per si mateixes ni el nom ni els cognoms de l&#39;usuari. L&#39;usuari t&eacute; la possibilitat de configurar el seu navegador de manera que sigui informat de la recepci&oacute; de cookies, podent, si aix&iacute; ho desitja, impedir que s&#39;instal&middot;lin en el seu disc dur. No obstant aix&ograve;, per accedir als llocs web de LOVERS WINE ELEGANCE SL, no &eacute;s preceptiva la instal&middot;laci&oacute; de cookies. L&#39;usuari es compromet a abstenir-se de reproduir, copiar, distribuir, posar a disposici&oacute; o de qualsevol altra forma comunicar p&uacute;blicament, transformar o modificar els Continguts, llevat que es compti amb l&#39;autoritzaci&oacute; de l&#39;titular dels corresponents drets o aix&ograve; resulti legalment perm&egrave;s.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">7. Protecci&oacute; de dades personals</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">De conformitat amb el que estableix la Llei Org&agrave;nica i el Reglament General-UE-2016/679 de Parlament i Consell d&#39;Europa de protecci&oacute; de dades de car&agrave;cter personal, aprovat el 27 d&#39;abril de 2016, LOVERS WINE ELEGANCE SL, informa als usuaris del seu website que estem obligats a guardar secret professional sobre les dades personals recollides per l&#39;empresa mitjan&ccedil;ant els formularis a les seves p&agrave;gines, aquesta obligaci&oacute; continu&eacute;s fins i tot despr&eacute;s d&#39;haver finalitzat la nostra relaci&oacute; comercial o contractual, i en cap cas podrem fer p&uacute;bliques les dades personals de els visitants i clients al web sense el seu consentiment. Els menors de 13 anys no poden prestar el seu consentiment per a un comer&ccedil; reculli i tracti les seves dades personals; nom&eacute;s els seus representants legals (pares o tutors) s&oacute;n els que poden fer-ho en nom seu. Aquells comer&ccedil;os que necessitin tractar dades de menors de 13 anys, han de disposar dels mitjans per obtenir el consentiment dels seus pares o tutors, per exemple, mitjan&ccedil;ant un missatge de correu electr&ograve;nic dirigit a algun d&#39;ells que contingui un enlla&ccedil; a un formulari electr&ograve;nic. No es pot demanar als menors de 13 anys dades sobre l&#39;&agrave;mbit familiar, sent l&#39;&uacute;nica excepci&oacute; les dades d&#39;identificaci&oacute; i contacte dels pares o tutors. Aquestes dades, seran introdu&iuml;des en un fitxer automatitzat sota la responsabilitat de l&#39;administrador del web de, LOVERS WINE ELEGANCE SL, amb la finalitat de poder facilitar, agilitzar i complir els compromisos establerts entre ambdues parts. Aix&iacute; mateix, LOVERS WINE ELEGANCE SL, informa de la possibilitat d&#39;exercir els drets d&#39;acc&eacute;s, que permet a l&#39;usuari web, con&egrave;ixer quines dades personals t&eacute; l&#39;administrador d&#39;aquesta p&agrave;gina i en aquest cas contest&eacute;s en un termini de 30 dies, sempre que conservi els dades, rectificaci&oacute;, que permet corregir errors, modificar les dades que siguin inexactes o incompletes i garantir la certesa de la informaci&oacute;, oposici&oacute; que podr&agrave; sol&middot;licitar i aconseguir que no porti a terme el tractament de dades, supressi&oacute; que permet que se suprimeixin les dades inadequats o excessius, limitaci&oacute;, pel que pot sol&middot;licitar que es limiti el tractament de les seves dades quan hagi exercit el seu dret a la rectificaci&oacute; de les seves dades personals, i portabilitat, perqu&egrave; l&#39;usuari pugui obtenir una c&ograve;pia de les dades personals que hagi facilitat en la web per tal de poder transmetre a altres serveis, aquests drets es podran exercir per qualsevol mitj&agrave; que deixi const&agrave;ncia del seu enviament i de la seva recepci&oacute; a l&#39;adre&ccedil;a: CL BALMES 13 3.1 .. Codi Postal: 08691. Localitat: MONISTROL DE MONTSERRAT Prov&iacute;ncia: BARCELONA. Correu electr&ograve;nic: <a data-auto-recognition=\"true\" href=\"mailto:info@mentcreativa.es\" class=\"wixui-rich-text__text\">info@mentcreativa.es</a>, aportant fotoc&ograve;pia de l&#39;DNI o documentaci&oacute; alternativa que acrediti la seva identitat. Mentre no ens comuniqui el contrari, entendrem que les seves dades no han estat modificades, que vost&egrave; es compromet a notificar-nos qualsevol variaci&oacute; i que tenim el consentiment per utilitzar-los a fi de poder fidelitzar la relaci&oacute; entre les parts. L&#39;enviament de les seves dades mitjan&ccedil;ant el / els formularis de la nostra web estar&agrave; supeditat obligat&ograve;riament al fet que hagi llegit / acceptat la Pol&iacute;tica de Privacitat, mitjan&ccedil;ant un check box obligatori a peu de l&#39;formulari. D&#39;acord amb el que estableix la Llei 34/2002, de Serveis de la Societat de la Informaci&oacute; i el Comer&ccedil; Electr&ograve;nic en el seu article 21, sol&middot;licitem el seu consentiment per poder realitzar comunicacions publicit&agrave;ries que considerem puguin ser del seu inter&egrave;s, per correu electr&ograve;nic o per qualsevol altre mitj&agrave; de comunicaci&oacute; electr&ograve;nica equivalent, aquest consentiment l&#39;acceptar&agrave; o negar&agrave; amb un check box obligatori a peu de l&#39;formulari.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">8. PROPIETAT INTEL&middot;LECTUAL</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">Els drets de propietat intel&middot;lectual i industrial derivats de tots els textos, imatges, aix&iacute; com dels mitjans i formes de presentaci&oacute; i muntatge de les seves p&agrave;gines pertanyen, per si mateixos o com a cession&agrave;ria, a LOVERS WINE ELEGANCE SL Seran, per tant, obres protegides amb propietat intel&middot;lectual per l&#39;ordenament jur&iacute;dic espanyol i se&#39;ls podr&agrave; aplicar tant la normativa espanyola i comunit&agrave;ria en aquest camp, com els tractats internacionals relatius a la mat&egrave;ria i subscrits per Espanya. Tots els drets reservats. En compliment de la Llei de la Propietat Intel&middot;lectual es prohibeix expressament la reproducci&oacute;, distribuci&oacute;, comunicaci&oacute; p&uacute;blica i utilitzaci&oacute; de la totalitat o part dels continguts de les seves p&agrave;gines web sense el consentiment expl&iacute;cit de LOVERS WINE ELEGANCE SL Aix&iacute; mateix, LOVERS WINE ELEGANCE SL, es reserva la facultat de presentar les accions civils o penals que consideri oportunes per la utilitzaci&oacute; indeguda de les seves p&agrave;gines web i continguts o per l&#39;incompliment d&#39;aquestes condicions.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">9. SEGELLS DE CONFIAN&Ccedil;A</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">Els segells de confian&ccedil;a s&oacute;n distintius que es proporcionen a les botigues en l&iacute;nia per demostrar la seva qualitat i seguretat en la venda en l&iacute;nia. Per aconseguir el segell, aquestes s&oacute;n auditades o avaluades per comprovar que compleixen els criteris de seguretat en la compra i compliment legal en mat&egrave;ria de privacitat i protecci&oacute; de dades dels consumidors. Les botigues que disposen d&#39;un segell de confian&ccedil;a estan adherides a un codi de conducta i solen oferir als consumidors procediments alternatius de resoluci&oacute; de conflictes senzills, r&agrave;pids i c&ograve;modes.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">10. CERTIFICATS DE COMPLIMENT LSSI-CE i protecci&oacute; de dades</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\"><a data-auto-recognition=\"true\" href=\"http://www.mentcreativa.es\" target=\"_blank\" class=\"wixui-rich-text__text\">http://www.mentcreativa.es</a> compleix amb la normativa de protecci&oacute; de dades vigent i amb la LSSI-CE, i ha estat assessorada en aquestes normatives per GH &amp; S. de JORDI COMAS BIGAS, per la qual cosa se li atorguen sengles certificats en format d&#39;imatge digital perqu&egrave; pugui exposar-los al seu lloc web.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.5em; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">11. ACCIONS LEGAL, LEGISLACI&Oacute; APLICABLE I JURISDICCI&Oacute;</span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:13px; line-height:1.5em; text-align:center;\"><span class=\"color_11 wixui-rich-text__text\"><span style=\"font-size:13px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:arial,ｍｓ ｐゴシック,ms pgothic,돋움,dotum,helvetica,sans-serif;\" class=\"wixui-rich-text__text\">La relaci&oacute; entre l&#39;usuari i LOVERS WINE ELEGANCE SL es regir&agrave; per la normativa espanyola vigent i seran competents per a decidir sobre qualsevol controv&egrave;rsia que pugui sorgir entre l&#39;usuari i LOVERS WINE ELEGANCE SL ,, els jutjats o tribunals de la localitat de MANRESA</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"}}}},"nicknameToCompIdMaps":{}}