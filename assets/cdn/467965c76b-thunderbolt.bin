p":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-iod4koc6","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expandir imagen","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iod4jm0z":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Toda comunicaci&oacute;n y relaci&oacute;n empieza con un simple </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">HOLA</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">En tu Agencia de Comunicaci&oacute;n </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">MENT CREATIVA</span></span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">, </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">es lo que queremos conseguir ...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Que nuestros clientes sean nuestros </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">AMIGOS</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"> </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">y </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">COLABORADORES</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Y &iquest;C&oacute;mo lo lograremos?</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Cuidando de sus negocios y empresas como si fueran nuestros.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Ofreciendo soluciones y estrategias efectivas e integrales de</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">DISE&Ntilde;O</span> y <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">PUBLICIDAD</span> que sumen valor y generen construcci&oacute;n de sus marcas, a trav&eacute;s de nuestra <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CREATIVIDAD.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">Generando grandes <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">IMPACTOS EMOCIONALES</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">al consumidor ; creando as&iacute;, experiencias &uacute;nicas que permitan alcanzar <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">FIDELIDAD</span> y <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">LEALTAD</span> hacia sus marcas.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">Y finalmente, contribuyendo con el <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">DESAROLLO</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">y <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CRECIMIENTO</span> comercial de nuestros <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CLIENTES</span>.</p>\n","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keitsxlt":{"alt":"LOGO_ES.jpg","width":1362,"height":621,"uri":"32797a_84b4d7e51a414648b7d8755206b74a2f~mv2.jpg","name":"LOGO_ES.jpg","containerId":"comp-keitsxlt","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_84b4d7e51a414648b7d8755206b74a2f~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_ES.jpg","srcset":"https://static.wixstatic.com/media/32797a_84b4d7e51a414648b7d8755206b74a2f~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_ES.jpg 1x, https://static.wixstatic.com/media/32797a_84b4d7e51a414648b7d8755206b74a2f~mv2.jpg/v1/fill/w_1200,h_548,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_ES.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":600,"height":274,"objectFit":"cover"}}},"containerWidth":600,"containerHeight":274,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-keitsxlt","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expandir imagen","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-lbw33kpn":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"contain