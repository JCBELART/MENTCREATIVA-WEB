":""},"Containerk0nup":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}},"comp-lbw33kpm":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33kpm","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"comp-iod4koc6":{"width":923,"height":307,"uri":"32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg","title":"CHORRO.jpg","containerId":"comp-iod4koc6","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg/v1/fill/w_1021,h_341,al_c,lg_1,q_80,enc_avif,quality_auto/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg/v1/fill/w_1021,h_341,al_c,lg_1,q_80,enc_avif,quality_auto/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg/v1/fill/w_1103,h_368,al_c,lg_1,q_85,enc_avif,quality_auto/32797a_bc79de8bbf1e40128edc6ff12dcb89f1~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":1021,"height":341,"objectFit":"cover"}}},"containerWidth":1021,"containerHeight":341,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"fr","compId":"comp-iod4koc6","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Agrandir l'image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iod4jm0z":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Chaque communication et relation commence par un simple</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">BONJOUR</span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Dans votre Agence de Communication</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">MENT CREATIVA</span></span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">, est ce que nous voulons r&eacute;aliser ...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Laissez nos clients &ecirc;tre nos</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">AMIS</span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"> </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">et</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">COLLABORATEURS</span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Et comment allons-nous y parvenir?</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Prendre soin de vos entreprises comme si elles &eacute;taient les n&ocirc;tres. Proposer des solutions et des strat&eacute;gies de</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">DESIGN</span> et <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">PUBLICIT&Eacute;</span> <span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">efficaces et compl&egrave;tes</span> qui ajoutent de la valeur et g&eacute;n&egrave;rent la construction de vos marques, &agrave; travers notre <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CR&Eacute;ATIVIT&Eacute;.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">G&eacute;n&eacute;rer de grands </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">IMPACTS &Eacute;MOTIONNELS</span><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">&nbsp;au consommateur; cr&eacute;ant ainsi des exp&eacute;riences uniques qui atteignent la </span><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\">CONFIANCE</span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">&nbsp;</span><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">et la </span><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">FID&Eacute;LIT&Eacute;</span><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"> &agrave; leurs marques.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">Et enfin, contribuer au <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">D&Eacute;VELOPPEMENT</span>&nbsp;et <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CROISSANCE</span> commerciale de nos <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CLIENTS</span> .</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keitsxlt":{"alt":"LOGO_FR.jpg","width":1362,"height":621,"uri":"32797a_0d40f214436e4f0793fb1bd7bf5be34a~mv2.jpg","name":"LOGO_FR.jpg","containerId":"comp-keitsxlt","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_0d40f214436e4f0793fb1bd7bf5be34a~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_FR.jpg","srcset":"https://static.wixstatic.com/media/32797a_0d40f214436e4f0793fb1bd7bf5be34a~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_FR.jpg 1x, https://static.wixstatic.com/media/32797a_0d40f214436e4f0793fb1bd7bf5be34a~mv2.jpg/v1/fill/w_1200,h_548,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_FR.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":600,"height":274,"objectFit":"cover"}}},"containerWidth":600,"containerHeight":274,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"fr","compId":"comp-keitsxlt","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Agrandir l'image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-lbw33kpn":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33kpn","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"comp-iod7wf9d":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:50px; text-align:cente