":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofmxrb4":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">L&#39;IDENTIT&Eacute; D&#39;ENTREPRISE</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">L&#39;identit&eacute; corporative ou visuelle de votre entreprise n&eacute;cessite une harmonie de design, de couleurs et d&#39;agencement de tous les &eacute;l&eacute;ments.</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofp5yck":{"width":540,"height":314,"uri":"32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png","containerId":"comp-iofp5yck","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_291,h_170,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png","srcset":"https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_291,h_170,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png 1x, https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_582,h_340,al_c,lg_1,q_85,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":170,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":170,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"fr","compId":"comp-iofp5yck","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Agrandir l'image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofp5yc6":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">DESIGN GRAPHIQUE</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">Nous r&eacute;alisons toutes sortes de projets li&eacute;s &agrave; la conception graphique et &agrave; la cr&eacute;ation graphique. Nous mettons &agrave; votre disposition plusieurs moyens pour faire passer votre message et le faire impacter votre audience:</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; text-align:justify;\">&nbsp;</p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">AFFICHES</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">BROCHURES ET TRIPTYCHES</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">CARTES DE VISITE</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">PAPETERIE DE BASE</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">&Eacute;TIQUETTES DE VIN</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">CALENDRIERS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">JOURNAUX</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">EMBALLAGE ...</p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofpcucy":{"width":1200,"height":761,"uri":"32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","title":"rotulacion.jpg","containerId":"comp-iofpcucy","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"