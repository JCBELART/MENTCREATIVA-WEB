axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-k9o6jf0b":{"html":"<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:23px; text-align:center;\"> <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"color_12 wixui-rich-text__text\"><span style=\"font-size:23px;\" class=\"wixui-rich-text__text\">OUR 3D PRINTING SERVICES</span></span></span></span> </h3>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-k9o6omk4":{"html":"<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:23px; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"color_28 wixui-rich-text__text\"><span style=\"font-size:23px;\" class=\"wixui-rich-text__text\">QUALITY</span></span></span></span></h3>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">We have the latest 3d printer technology on the market</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">and with the philosophy that quality is our priority, therefore we offer excellent quality</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">and a good deal with the client.</span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-k9o6rn31":{"html":"<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:23px; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"color_28 wixui-rich-text__text\"><span style=\"font-size:23px;\" class=\"wixui-rich-text__text\">3D PRINT</span></span></span></span></h3>\n\n<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</h3>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">We perform 3d printing of any object and geometry, we have the latest technology on the market and the latest materials.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">And always in constant innovation.</span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-k9o77yib":{"html":"<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:23px; text-align:center;\"><span class=\"color_12 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:din-next-w01-light,din-next-w02-light,din-next-w10-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:23px;\" class=\"wixui-rich-text__text\">WHY PRINT A 3D object?</span></span></span></span></h3>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">The first thing that comes to mind when we talk about 3d printing is the technological manufacturing of prototypes, and it really is, but it does not stop here. Since its inception, 3D printers have been used almost exclusively for prototypes.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Nowadays, thanks to the different types of materials, such as: ABS, PLA, FLEXIBLE, PETT, etc. It has allowed us to print almost any object such as molds of pieces, objects, food, flexible mobile phone cases, and a large etc. Prototypes are the great objective of 3d printing thanks to the agility of printing any object, in a fast time and at a really low cost.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">We know how important a fast 3d printing, with good quality, with a low cost and a very fast service is for your company, we are not going to sell you the motorcycle so that you can print with us, we want you to trust us for your 3d printing because We know what we are capable of and what we can offer you or your company.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-k9o7hrlz":{"skin":"AppWidgetSkin","meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}},"comp-k9o7hrsr":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}},"comp-k9o7hrtj":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:32px;\"><span style=\"color:#1A2DF3;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">Ponte en contacto</span></span></span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-k9o7hrty":{"withShadow":false,"link":{"href":"mailto:joancarlesdisseny@hotmail.com","target":"_self","type":"EmailLink","id":"dataItem-k9o7hru1"},"fullNameCompType":"wysiwyg.viewer.components.VectorImage","language":"en","mainPageId":"axdf2","compId":"comp-k9o7hrty","trackClicksAnalytics":false,"experiments":{"specs.thunderbolt.DatePickerPortal":true,"specs.thunderbolt.DisableDocumentScrollWhenLightBoxOpen":true,"specs.thunderbolt.EnableCustomCSSVarsForLoginSocialBar":true,"specs.thunderbolt.FreemiumBannerOdeditor":true,"specs.thunderbolt.TextInputAutoFillFix":true,"specs.thunderbolt.UseLoginSocialBarCustomMenu":true,"specs.thunderbolt.UseNestedLoginSocialBarMenuItems":true,"specs.thunderbolt.UseNewLoginBarDropdownMenuAlignment":true,"specs.thunderbolt.UseNewLoginSocialBarElementStructure":true,"specs.thunderbolt.UseNewLoginSocialBarMemberInitialsAvatar":true,"specs.thunderbolt.WixFreeSiteBannerDesktop":true,"specs.thunderbolt.WixFreeSiteBannerMobile":true,"specs.thunderbolt.a11yContrast":true,"specs.thunderbolt.addIdAsClassName":true,"spe