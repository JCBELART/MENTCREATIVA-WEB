><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">para PARTICULARES, EMPRESAS, FAMOSOS, RESTAURANTES, CATERINGS, EVENTOS...</span></span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0jqioi":{"alt":"PORTADA.png","width":279,"height":512,"uri":"32797a_5e83059b84024e10b14f29c88ece600c~mv2.png","name":"PORTADA.png","containerId":"comp-ld0jqioi","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_5e83059b84024e10b14f29c88ece600c~mv2.png/v1/fill/w_166,h_304,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/PORTADA.png","srcset":"https://static.wixstatic.com/media/32797a_5e83059b84024e10b14f29c88ece600c~mv2.png/v1/fill/w_166,h_304,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/PORTADA.png 1x, https://static.wixstatic.com/media/32797a_5e83059b84024e10b14f29c88ece600c~mv2.png/v1/fill/w_332,h_608,al_c,lg_1,q_85,enc_avif,quality_auto/PORTADA.png 2x","css":{"container":{"position":"relative"},"img":{"width":166,"height":304,"objectFit":"cover"}}},"containerWidth":166,"containerHeight":304,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-ld0jqioi","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expandir imagen","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-ld0kewa3":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-ld0kewa3","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false}},"comp-ld0kewdt":{"fillLayers":{"containerId":"comp-ld0kewdt","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":980}},"translations":{"ariaLabel":"cambios en el contenido al pasar el cursor"}},"comp-ld0kewdz":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:36px; line-height:normal; text-align:center;\"><span class=\"color_43 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.05em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:36px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">&iquest;QUIEN SOMOS?</span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0kewe8":{},"comp-ld0kewe5":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">Somos un equipo multidisciplinar de expertos, profesionales e investigadores capaces de crear desde las experiencias m&aacute;s anal&oacute;gicas a las m&aacute;s digitales para explicar una historia</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">o crear una experiencia a trav&eacute;s de dise&ntilde;o de etiquetas &uacute;nicas y con mucho valor a&ntilde;adido.</span></span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0kn2ih":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:36px; line-height:normal; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.05em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:36px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">&iquest;C&Oacute;MO LO HACEMOS?</span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0kn2iz":{},"comp-ld0kn2ir":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">En MENTCREATIVA dise&ntilde;amos etiquetas experienciales y experiencias &uacute;nicas en torno al vino.</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">Creamos y comunicamos la historia que quieres contar del vino y ponemos de relieve</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">el valor de quien lo produce para que la gente lo compre y lo disfrute.</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">Construimos experiencias memorables en torno al vino para que se convierta en un producto inimitable. </span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">Nuestro objetivo es el dise&ntilde;o y personalizaci&oacute;n de vinos &uacute;nicos</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">y diferentes que destaquen de tu competencia.</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:25px; line-height:1.6em; text-align:center;\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">TIPO DE ETIQUETAS QUE DISE&Ntilde;AMOS PARA TI</span></span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0la4r7":{"withShadow":true,"link":{},"fullNameCompType":"wysiwyg.viewer.components.VectorImage","language":"es","mainPageId":"axdf2","compId":"comp-ld0la4r7","trackClicksAnalytics":false,"experiments":{"specs.thunderbolt.DatePickerPortal":true,"specs.thunderbolt.DisableDocumentScrollWhenLightBoxOpen":true,"specs.thunderbolt.EnableCustomCSSVarsForLoginSocialBar":true,"specs.thunderbolt.FreemiumBannerOdeditor":true,"specs.thunderbolt.TextInputAutoFillFix":true,"specs.thunderbolt.UseLoginSocialBarCustomMenu":true,"specs.thunderbolt.UseNestedLoginSocialBarMenuItems":true,"specs.thunderbolt.UseNewLoginBarDropdownMenuAlignment":true,"specs.thunderbolt.UseNewLoginSocialBarElementStructure":true,"specs.thunderbolt.UseNewLoginSocialBarMemberInitialsAvatar":true,"specs.thunderbolt.WixFreeSiteBannerDesktop":true,"specs.thunderbolt.WixFreeSiteBannerMobile":true,"specs.thunderbolt.a11yContrast":true,"specs.thunderbolt.addIdAsClassName":true,"specs.thunderbolt.builderBoxSizingBorderBox":true,"specs.thunderbolt.buttonUdp":true,"specs.thunderbolt.calculateCollapsibleTextLineHeightByFont":true,"specs.thunderbolt.customImageDomain":true,"specs.thunderbolt.dom_store":true,"specs.thunderbolt.dontApplyDacOverridesOnBoBApps":true,"specs.thunderbolt.dynamicPageLinkTarget":true,"specs.thunderbolt.dynamicSlots":true,"specs.thunderbolt.fiveGridLineStudioSkins":true,"specs.thunderbolt.fixDocumentLinkInPremiumPreview":true,"specs.thunderbolt.fixFirefoxLinkBarIntrinsicSizing":true,"specs.thunderbolt.imageEncodingAVIF":true,"specs.thunderbolt.interactionsUseReactionEffectId":true,"specs.thunderbolt.isClassNameToRootEnabled":true,"specs.thunderbolt.isClassNameToRootEna