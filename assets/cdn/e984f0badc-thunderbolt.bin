Components":[]}},"comp-ld0ml5sq":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:36px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.05em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:36px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">ETIQUETAS CON REALIDAD AUMENTADA</span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0ml5sw":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">La REALIDAD AUMENTADA nos permite a&ntilde;adir capas de informaci&oacute;n visual sobre el mundo real</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">que nos rodea, utilizando la tecnolog&iacute;a, dispositivos como nuestros propios tel&eacute;fonos m&oacute;viles.</span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">Esto nos ayuda a generar experiencias que aportan un conocimiento relevante sobre nuestro entorno, </span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">y adem&aacute;s recibimos esa informaci&oacute;n en tiempo real. </span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">A trav&eacute;s de la etiqueta y un dispositivo m&oacute;vil podremos visualizar:</span></span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0ml5sz":{"alt":"ETIQUETES AMB AR.png","width":1969,"height":771,"uri":"32797a_32f504c965e3403b881536bd17ef7ba0~mv2.png","name":"ETIQUETES AMB AR.png","containerId":"comp-ld0ml5sz","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_32f504c965e3403b881536bd17ef7ba0~mv2.png/v1/fill/w_788,h_308,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20AMB%20AR.png","srcset":"https://static.wixstatic.com/media/32797a_32f504c965e3403b881536bd17ef7ba0~mv2.png/v1/fill/w_788,h_308,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20AMB%20AR.png 1x, https://static.wixstatic.com/media/32797a_32f504c965e3403b881536bd17ef7ba0~mv2.png/v1/fill/w_1576,h_616,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20AMB%20AR.png 2x","css":{"container":{"position":"relative"},"img":{"width":788,"height":308,"objectFit":"cover"}}},"containerWidth":788,"containerHeight":308,"isInFirstFold":false,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-ld0ml5sz","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expandir imagen","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-ld0mzgw7":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:rgb(0, 0, 0); font-family:futura-lt-w01-light, futura-lt-w05-light, sans-serif; font-weight:700;\" class=\"wixui-rich-text__text\">EJEMPLO DE ETIQUETA CON REALIDAD AUMENTADA PARA EL VINO</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:32px; line-height:1.6em; text-align:center;\"><span style=\"color:rgb(0, 0, 0); font-family:futura-lt-w01