un rasgo diferenciador </span></span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.6em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">LA CREATIVIDAD para destacar tu botella del resto.</span></span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ld0lfwrw":{"alt":"ETIQUETES TRADICIONALS.png","width":1969,"height":771,"uri":"32797a_5b7ddf8d96484b2780b2d1552984ec37~mv2.png","name":"ETIQUETES TRADICIONALS.png","containerId":"comp-ld0lfwrw","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_5b7ddf8d96484b2780b2d1552984ec37~mv2.png/v1/fill/w_788,h_308,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20TRADICIONALS.png","srcset":"https://static.wixstatic.com/media/32797a_5b7ddf8d96484b2780b2d1552984ec37~mv2.png/v1/fill/w_788,h_308,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20TRADICIONALS.png 1x, https://static.wixstatic.com/media/32797a_5b7ddf8d96484b2780b2d1552984ec37~mv2.png/v1/fill/w_1576,h_616,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/ETIQUETES%20TRADICIONALS.png 2x","css":{"container":{"position":"relative"},"img":{"width":788,"height":308,"objectFit":"cover"}}},"containerWidth":788,"containerHeight":308,"isInFirstFold":false,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"es","compId":"comp-ld0lfwrw","mainPageId":"axdf2","trackCli