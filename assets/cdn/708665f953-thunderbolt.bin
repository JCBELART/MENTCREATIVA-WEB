mInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-kefmgpkq":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; text-align:center;\"><span style=\"color:#FA9513;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">And to show ONE BUTTON ...</span></span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; line-height:0.6em; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">Do you want to see how AUGMENTED REALITY works live?</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">It is very easy, just follow the steps that we describe and enjoy a UNIQUE experience!</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kefu5hbp":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; text-align:center;\"><span style=\"color:#FA9513;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">IMPORTANT!</span></span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">Do not stop focusing on the printed MARKER since if you do, the application will stop.</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">In that case, refocus on the MARKER and the APP will automatically run again.</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">If you have any questions, problems or just want a non-binding quote, do not hesitate to contact us through </span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">our form or our mobile phone +34 626 812 776.</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keegapa9":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:61px; line-height:1em; tex