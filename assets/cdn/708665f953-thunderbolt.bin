align:center;\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\">AUGMENTED REALITY allows us to add layers of visual information about the real world that surrounds us, using technology, devices such as our own mobile phones. This helps us to generate experiences that provide relevant knowledge about our environment, and we also receive that information in real time.</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kefkv16e":{"alt":"Agencia de Diseño, Publicidad, Impresión 3D, Rotulación y mucho más, dónde tus ideas se harán realidad.","width":984,"height":984,"uri":"32797a_8a9c5127b92c4b4582a7b8c81054b73a~mv2.png","name":"COHETE.png","containerId":"comp-kefkv16e","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_8a9c5127b92c4b4582a7b8c81054b73a~mv2.png/v1/fill/w_203,h_203,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/COHETE.png","srcset":"https://static.wixstatic.com/media/32797a_8a9c5127b92c4b4582a7b8c81054b73a~mv2.png/v1/fill/w_203,h_203,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/COHETE.png 1x, https://static.wixstatic.com/media/32797a_8a9c5127b92c4b4582a7b8c81054b73a~mv2.png/v1/fill/w_406,h_406,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/COHETE.png 2x","css":{"container":{"position":"relative"},"img":{"width":203,"height":203,"objectFit":"cover"}}},"containerWidth":203,"containerHeight":203,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-kefkv16e","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-kefl1lax":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; text-align:center;\"><span style=\"color:#FA9513;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">Advantages of Augmented Reality</span></span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; line-height:0.6em; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">This technology has clear advantages when applied in specific sectors.</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">ALLOWS OPTIMIZE TIMES IN WORKERS &#39;DAILY TASKS</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">IT IS A NEW COMMUNICATION CHANNEL WITH USERS AND CUSTOMERS</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">IT IS A TECHNOLOGY THAT ALLOWS YOU TO WORK WITH YOUR &quot;HANDS FREE&quot;</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">AN EXPLANATION CAN BE VIEWED IN ANY SECTOR IN REAL TIME</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">BRINGING 3D TECHNOLOGY TO THE COMMUNICATION AND MARKETING SECTOR</span></span></span></h2>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keflor8m":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; line-height:1.2em; text-align:center;\"><span style=\"color:#FA9513;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">How can I apply Augmented Reality to my projects?</span></span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; line-height:1.2em; text-align:center;\">&nbsp;</h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; line-height:1.2em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">Augmented Reality offers infinite possibilities for all kinds of areas, whether in marketing, maintenance or sales. It can also be applied in many more sectors such as education, medicine</span></span></span></h2>\n\n<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:15px; line-height:1.2em; text-align:center;\"><span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">and a few more ... Here we show you some of them:</span></span></span></h2>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keflt41z":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; text-align:center;\"> <span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">MARKETING AND</span></span></span></span> </h2><h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:25px; text-align:center;\"> <span style=\"color:#000000;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:25px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_85-heavy1475544,sans-serif;\" class=\"wixui-rich-text__text\">ADVERTISING</span></span></span></span> </h2>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kefly5f7":{"alt":"Agencia de Diseño, Publicidad, Impresión 3D, Rotulación y mucho más, dónde tus ideas se harán realidad.","width":984,"height":984,"uri":"32797a_a87d89a1f9e04b9d8803a491fa073a38~mv2.png","name":"TIENDA.png","containerId":"comp-kefly5f7","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_a87d89a1f9e04b9d8803a491fa073a38~mv2.png/v1/fill/w_152,h_152,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/TIENDA.png","srcset":"https://static.wixstatic.com/media/32797a_a87d89a1f9e04b9d8803a491fa073a38~mv2.png/v1/fill/w_152,h_152,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/TIENDA.png 1x, https://static.wixstatic.com/media/32797a_a87d89a1f9e04b9d8803a491fa073a38~mv2.png/v1/fill/w_304,h_304,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/TIENDA.png 2x","css":{"container":{"position":"relative"},"img":{"width":152,"height":152,"objectFit":"cover"}}},"containerWidth":152,"containerHeight":152,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-kefly5f7","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-keflz0gr":{"html":