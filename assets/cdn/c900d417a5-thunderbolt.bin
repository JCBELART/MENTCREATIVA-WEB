skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofq559j":{"width":700,"height":335,"uri":"32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg","title":"publicidad.jpg","containerId":"comp-iofq559j","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_582,h_340,al_c,lg_1,q_80,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":170,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":170,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"ca","compId":"comp-iofq559j","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Amplia la imatge","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofq559k2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">PUBLICITAT</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Som una ag&egrave;ncia de publicitat multi - sectorial. Treballem per a la ind&uacute;stria i el comer&ccedil; en general. Ens dirigim principalment a les empreses petites i mitjanes, que s&oacute;n el motor de l&#39;economia.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">El nostre desig &eacute;s ajudar als nostres clients a posicionar les seves marques per vendre els seus productes, serveis i augmentar la fidelitat dels seus clients.</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofq559k":{"width":1300,"height":562,"uri":"32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","title":"WEB.jpg","containerId":"comp-iofq559k","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"ca","compId":"comp-iofq559k","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Amplia la imatge","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofq559k1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">DISSENY WEB</span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Necessites un web per al teu negoci?</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Creem tot tipus de portals web professionals ajustats a les necessitats dels nostres clients.</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Si no est&agrave;s a Internet, no existeixes.</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">DISSENY I DESENVOLUPAMENT WEB</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"