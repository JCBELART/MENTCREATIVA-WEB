xui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">FULLETS I TR&Iacute;PTICS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">TARGETES DE VISITA</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">PAPERERIA B&Agrave;SICA</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">ETIQUETES DE VINS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">CALENDARIS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">REVISTES</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">PACKAGING ...</p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofpcucy":{"width":1200,"height":761,"uri":"32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","title":"rotulacion.jpg","containerId":"comp-iofpcucy","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/