":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"ca","compId":"comp-iod4koc6","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Amplia la imatge","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iod4jm0z":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Tota comunicaci&oacute; i relaci&oacute; comen&ccedil;a amb un simple</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">HOLA</span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">En el teu Ag&egrave;ncia de Comunicaci&oacute;</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">MENT CREATIVA<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">,</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&eacute;s el que volem aconseguir ...</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Que els nostres clients siguin els nostres</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">AMICS</span> <span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"> </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">i</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">COL&middot;LABORADORS</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">I Com ho aconseguirem?</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Tenint cura dels seus negocis i empreses com si fossin nostres.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Oferint solucions i estrat&egrave;gies efectives i integrals de</span> <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">DISSENY</span> i <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">PUBLICITAT</span> que sumin valor i generin construcci&oacute; de les seves marques, mitjan&ccedil;ant la nostra <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CREATIVITAT.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">Generant grans <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">IMPACTES EMOCIONALS</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">a el consumidor; creant aix&iacute;, experi&egrave;ncies &uacute;niques que permetin assolir <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">FIDELITAT</span> i <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">LLEIALTAT</span> cap als seus marques.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">I finalment, contribuint amb el <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">DESENVOLUPAMENT</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">i <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CREIXEMENT</span> comercial dels nostres <span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">CLIENTS.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keitsxlt":{"alt":"LOGO_MENT_CAT.jpg","width":1362,"height":621,"uri":"32797a_9acd2696aae54527ba003cb048342b71~mv2.jpg","name":"LOGO_MENT_CAT.jpg","containerId":"comp-keitsxlt","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_9acd2696aae54527ba003cb048342b71~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_MENT_CAT.jpg","srcset":"https://static.wixstatic.com/media/32797a_9acd2696aae54527ba003cb048342b71~mv2.jpg/v1/fill/w_600,h_274,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_MENT_CAT.jpg 1x, https://static.wixstatic.com/media/32797a_9acd2696aae54527ba003cb048342b71~mv2.jpg/v1/fill/w_1200,h_548,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/LOGO_MENT_CAT.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":600,"height":274,"objectFit":"cover"}}},"containerWidth":600,"containerHeight":274,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"ca","compId":"comp-keitsxlt","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Amplia la imatge","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-lbw33kpn":{"meshProps":{"wedges":[]