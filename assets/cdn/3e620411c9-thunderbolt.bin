siveOverride":{},"allowFullGIFTransformation":false},"comp-iofmxrb4":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">CORPORATE IDENTITY</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">The corporate or visual identity of your company requires a harmony of design, colors and arrangement of all elements.</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofp5yck":{"width":540,"height":314,"uri":"32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png","containerId":"comp-iofp5yck","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_291,h_170,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png","srcset":"https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_291,h_170,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png 1x, https://static.wixstatic.com/media/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png/v1/fill/w_582,h_340,al_c,lg_1,q_85,enc_avif,quality_auto/32797a_67dc5146bad04c52b0890301bd2aa7c1~mv1.png 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":170,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":170,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-iofp5yck","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofp5yc6":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">GRAPHIC DESIGN</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">We carry out all kinds of projects related to graphic design and graphic creation. We put at your disposal several ways to get your message across and make it impact your audience:</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px; text-align:justify;\">&nbsp;</p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">POSTERS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">BROCHURES AND TRIPTYCHES</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">BUSINESS CARDS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">BASIC STATIONERY</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">WINE LABELS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">CALENDARS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">JOURNALS</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">PACKAGING ...</p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofpcucy":{"width":1200,"height":761,"uri":"32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","title":"rotulacion.jpg","containerId":"comp-iofpcucy","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_d0aa759a2b6541e4a52c38d82985c64d~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-iofpcucy","mainPageId":"axdf2","trackClicksAnalytics":false,"pop