media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg/v1/fill/w_582,h_340,al_c,lg_1,q_80,enc_avif,quality_auto/32797a_b78b188634824e019d933c86cbeefdb0~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":170,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":170,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-iofq559j","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofq559k2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">ADVERTISING</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">We are a multi - sector advertising agency. We work for industry and commerce in general. We mainly target small and medium-sized companies, which are the engine of the economy.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Our desire is to help our clients to position their brands to sell their products, services and increase the loyalty of their clients.</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofq559k":{"width":1300,"height":562,"uri":"32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","title":"WEB.jpg","containerId":"comp-iofq559k","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_e6841658df5d433484c8966dde94fda5~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-iofq559k","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofq559k1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">WEB DESIGN</span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">Do you need a website for your business?</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">We create all kinds of professional web portals tailored to the needs of our clients.</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">If you are not on the Internet, you do not exist.</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">WEB DESIGN AND DEVELOPMENT</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">SEO POSITIONING</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">HOSTING AND ACCOMMODATION</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">TECHNICAL SERVICE</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">INFORMATIC SECURITY</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">SOCIAL MANAGER ...</span></span></p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lbw33ks5":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lbw33ks5","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-iofrpi8n":{"width":1900,"height":500,"uri":"32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg","title":"eventos2.jpg","containerId":"comp-iofrpi8n","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg 1x, https://static.wixstatic.com/media/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg/v1/fill/w_582,h_342,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_f9658ffced9940e4af4f7a5194514272~mv1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":291,"height":171,"objectFit":"cover"}}},"containerWidth":291,"containerHeight":171,"isInFirstFold":false,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-iofrpi8n","mainPageId":"axdf2","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-iofrpi96":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:30px; line-height:0.9em; text-align:center;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:jura,sans-serif;\" class=\"wixui-rich-text__text\">EVENTS</span></span></span></span></h2>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">MENT CREATIVA</span> acts as an exclusive Events Agency. We have the mission of creating unique moments through values such as excellence, presence, safety, dynamism and personalization. The experiences of our clients are our goal and we always arrive through the unconditional passion for our work and assuming that nothing is impossible.</span></span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px; text-align:justify;\">&nbsp;</p>\n\n<ul class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">CORPORATE EVENTS</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">PARTICULAR EVENTS</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">THEMATIC EVENTS</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">PROTOCOL</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">WEDDING ORGANIZATION</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">INCENTIVES &amp; TEAM BUILDING ...</span></span></p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofrpi961":{"width":5184,"height":3456,"uri":"32797a_35649c7ff9ef4850a744088e4fb1556a~mv1.jpg","title":"AUDIOVISUALES.jpg","containerId":"comp-iofrpi961","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_35649c7ff9ef4850a744088e4fb1556a~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_35649c7ff9ef4850a744088e4fb1556a~m