xt\" style=\"font-size:20px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">TV ADS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">CORPORATE VIDEOS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">PROMOTIONAL VIDEO</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">VIDEO-REPORTS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">VIDEO BOOKS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\">SPEECH AND SOUND ...</span></p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-iofrpi97":{"width":1600,"height":1065,"uri":"32797a_24e8bfd061e1416abd0dd006f43d0da5~mv1.jpg","title":"FOTOGRAFIA.jpg","containerId":"comp-iofrpi97","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_24e8bfd061e1416abd0dd006f43d0da5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_24e8bfd061e1416abd0dd006f43d0da5~mv1.jpg","srcset":"https://static.wixstatic.com/media/32797a_24e8bfd061e1416abd0dd006f43d0da5~mv1.jpg/v1/fill/w_291,h_171,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_24e8bfd061e1416abd0dd006f43d0da5~mv1.jpg 1x, http