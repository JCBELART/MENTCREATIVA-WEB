ign:justify;\"><span class=\"color_13 wixui-rich-text__text\">LITERARY SCRIPTS</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">WEB CONTENT</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">PRODUCT CONTENT</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">MAGAZINES AND BROCHURES</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">TEXTS</span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">TV ADS ...</span></span></p>\n</li>\n</ul>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-ioh51yxv":{"width":764,"height":552,"uri":"32797a_108b3fbcbb674a01adc25a0871b196fa~mv1.jpg","title":"escuela-modelos.jpg","containerId":"comp-ioh51yxv","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/32797a_108b3fbcbb674a01adc25a0871b196fa~mv1.jpg/v1/fill/w_291,h_170,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/32797a_108b3fbcbb674a01adc25a0871b196f